# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Vercel local project metadata and the build-time Flutter SDK cache
/.vercel/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local configuration and environment values
.env
.env.*
!.env.example
!.env.sample
/.vscode/
/android/local.properties
/android/key.properties

# Private credentials and signing keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*service-account*.json
*service_account*.json

# Local hosting and SDK caches
/.firebase/
/.fvm/
/.flutter-sdk/

# Local-only workspace notes (keep the actual application source tracked)
/AGENTS.md
/SOURCE_CODE.md
/LOGO_GUIDE.md
